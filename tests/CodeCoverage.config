<?xml version="1.0" encoding="utf-8"?>
<!-- The code coverage settings of the tests (Microsoft.Testing.Extensions.CodeCoverage). CI passes this file to
     dotnet test with the coverage-settings option; the path must be absolute. -->
<Configuration>
  <CodeCoverage>
    <Attributes>
      <Exclude>
        <!-- The overload traps: [Obsolete(…, error: true)] makes every call to them a compile error, so their bodies
             never run. The binding tests cover them. Every [Obsolete] member of the library is a trap. -->
        <Attribute>^System\.ObsoleteAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
