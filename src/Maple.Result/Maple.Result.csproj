<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Maple.Result</AssemblyName>
    <RootNamespace>Maple.Results</RootNamespace>

    <!-- Marks the assembly as trimmable and turns on the trim, AOT and single-file analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>Maple.Result</PackageId>
    <Title>Maple.Result — Result pattern with RFC 9457 errors</Title>
    <Description>An abstraction which contains the value or the error of the operation. It can be mapped to the HTTP response if needed.</Description>
    <Authors>Tom Maple</Authors>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>Result;Error;RFC-9457;RFC-7807</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PackageProjectUrl>https://github.com/TomMaple/Maple.Result</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TomMaple/Maple.Result</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maple.Result.Tests.Unit" />
  </ItemGroup>

  <!-- The analyzers and their code fixes ship inside this package (analyzers/dotnet/cs), so that every consumer gets them without a
       second reference. The two projects are built before this one (CI packs with no-build) but the library does not reference
       them: the package gets no dependency, and the library stays trimmable. The code-fix assembly is loaded by the IDE only. -->
  <ItemGroup>
    <ProjectReference Include="..\Maple.Result.Analyzers\Maple.Result.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Maple.Result.Analyzers.CodeFixes\Maple.Result.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Maple.Result.Analyzers\bin\$(Configuration)\netstandard2.0\Maple.Result.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Maple.Result.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\Maple.Result.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive\Maple.Result.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\.resources\icon.png" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <!-- The package README for nuget.org (absolute links, no GitHub alerts); the README.md of the repository is for GitHub. -->
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
