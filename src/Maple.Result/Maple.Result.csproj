<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Maple.Result</AssemblyName>
    <RootNamespace>Maple.Results</RootNamespace>

    <!-- Marks the assembly as trimmable and turns on the trim, AOT and single-file analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>Maple.Result</PackageId>
    <Title>Maple.Result — Result pattern with RFC 9457 errors</Title>
    <Description>Result pattern for .NET: Result and Result&lt;T&gt; with RFC 9457 problem details errors, chaining (synchronous, asynchronous and LINQ), localization and a built-in analyzer. No dependencies; Native AOT and trimming compatible.</Description>
    <Authors>Tom Maple</Authors>
    <Copyright>Copyright (c) Tom Maple</Copyright>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>result;result-pattern;error;error-handling;problem-details;rfc9457;rfc7807;railway-oriented-programming;functional;validation;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/TomMaple/Maple.Result/releases</PackageReleaseNotes>

    <!-- Checks the package when it is packed. The baseline (PackageValidationBaselineVersion, the API that this version must keep) is the
         latest published release that is not a pre-release, raised at every release; it is set once 3.0.0 is on nuget.org, as the restore
         downloads it and fails before. See "Package validation" in docs/conventions.md. -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PackageProjectUrl>https://github.com/TomMaple/Maple.Result</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TomMaple/Maple.Result</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maple.Result.Tests.Unit" />
  </ItemGroup>

  <!-- The analyzers and their code fixes ship inside this package (analyzers/dotnet/cs), so that every consumer gets them without a
       second reference. The two projects are built before this one (CI packs with no-build) but the library does not reference
       them: the package gets no dependency, and the library stays trimmable. The code-fix assembly is loaded by the IDE only. -->
  <ItemGroup>
    <ProjectReference Include="..\Maple.Result.Analyzers\Maple.Result.Analyzers.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" PackAsAnalyzer="true" />
    <ProjectReference Include="..\Maple.Result.Analyzers.CodeFixes\Maple.Result.Analyzers.CodeFixes.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" PackAsAnalyzer="true" />
    <None Include="buildTransitive\Maple.Result.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <!-- Packs each analyzer assembly from the output path of its project (GetTargetPath), so that a custom output path or the artifacts
       layout (UseArtifactsOutput) packs the assemblies that were built, not the files of a fixed bin folder. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);MapleResultPackAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="MapleResultPackAnalyzers">
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('PackAsAnalyzer', 'true'))" Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_MapleResultAnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_MapleResultAnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="..\..\.resources\icon.png" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <!-- The package README for nuget.org (absolute links, no GitHub alerts); the README.md of the repository is for GitHub. -->
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
