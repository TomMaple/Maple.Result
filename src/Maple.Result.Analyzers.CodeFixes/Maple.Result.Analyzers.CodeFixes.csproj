<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Loaded by the IDE next to the analyzers, which requires netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Maple.Result.Analyzers.CodeFixes</AssemblyName>
    <RootNamespace>Maple.Results.Analyzers.CodeFixes</RootNamespace>

    <!-- Shipped inside the Maple.Result package (analyzers/dotnet/cs), not as a package of its own. The code fixes are in an assembly
         of their own because they need the workspaces API, which the command-line compiler does not have (RS1038). -->
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same version as the compiler API of the analyzers. Dependabot ignores it, and CompilerReferenceUnitTests fails when it
         is raised (#331). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maple.Result.Analyzers\Maple.Result.Analyzers.csproj" />
  </ItemGroup>

</Project>
