<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- An analyzer is loaded by the compiler, which requires netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Maple.Result.Analyzers</AssemblyName>
    <RootNamespace>Maple.Results.Analyzers</RootNamespace>

    <!-- Shipped inside the Maple.Result package (analyzers/dotnet/cs), not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not newer than the compiler of the oldest SDK that builds a net10.0 consumer (the .NET 10 SDK). Dependabot ignores it, and
         CompilerReferenceUnitTests fails when it is raised (#331). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maple.Result.Analyzers.CodeFixes" />
    <InternalsVisibleTo Include="Maple.Result.Analyzers.Tests.Unit" />
  </ItemGroup>

  <!-- The git reference whose documentation the help links of the rules open: main, or the tag of the release that the Publish
       workflow builds (-p:MapleResultHelpLinkRef=vX.Y.Z), so that a published package opens the pages of its own version. It becomes
       the constant Rules.HelpLinkRef of a generated file. -->
  <PropertyGroup>
    <MapleResultHelpLinkRef Condition="'$(MapleResultHelpLinkRef)' == ''">main</MapleResultHelpLinkRef>
  </PropertyGroup>

  <Target Name="MapleResultGenerateHelpLinkRef" BeforeTargets="BeforeCompile">
    <!-- Set here, as the intermediate output path is known only when the targets run. -->
    <PropertyGroup>
      <MapleResultHelpLinkFile>$(IntermediateOutputPath)Rules.HelpLinkRef.g.cs</MapleResultHelpLinkFile>
    </PropertyGroup>

    <ItemGroup>
      <_MapleResultHelpLinkLine Include="// &lt;auto-generated /&gt;" />
      <_MapleResultHelpLinkLine Include="namespace Maple.Results.Analyzers%3B" />
      <_MapleResultHelpLinkLine Include="public static partial class Rules" />
      <_MapleResultHelpLinkLine Include="{" />
      <_MapleResultHelpLinkLine Include="    internal const string HelpLinkRef = &quot;$(MapleResultHelpLinkRef)&quot;%3B" />
      <_MapleResultHelpLinkLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(MapleResultHelpLinkFile)" Lines="@(_MapleResultHelpLinkLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(MapleResultHelpLinkFile)" />
      <FileWrites Include="$(MapleResultHelpLinkFile)" />
    </ItemGroup>
  </Target>

</Project>
